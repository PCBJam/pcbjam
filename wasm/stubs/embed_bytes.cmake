# cmake -DIN=<file> -DOUT=<file.cpp> -DSYMBOL=<name> -P embed_bytes.cmake
#
# Writes a C++ source that defines `extern "C" const unsigned char <name>[]` with the bytes of
# IN and `extern "C" const size_t <name>_size`.

file( READ ${IN} hex HEX )
string( LENGTH "${hex}" hexLength )
math( EXPR size "${hexLength} / 2" )
string( REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}" )

file( WRITE ${OUT}
      "// Generated by embed_bytes.cmake from ${IN}. Do not edit.\n"
      "#include <cstddef>\n"
      "extern \"C\" const unsigned char ${SYMBOL}[] = { ${bytes} };\n"
      "extern \"C\" const size_t ${SYMBOL}_size = ${size};\n" )
