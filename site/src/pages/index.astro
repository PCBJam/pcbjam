---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import FullKicad from '../sections/FullKicad.astro';
import OwnYourData from '../sections/OwnYourData.astro';
import SharePublish from '../sections/SharePublish.astro';
import Pricing from '../sections/Pricing.astro';
import Roadmap from '../sections/Roadmap.astro';
import Faq from '../sections/Faq.astro';
import Contact from '../sections/Contact.astro';

// Title and description carry the two search phrases people actually use
// ("KiCad online", "in your browser") plus the differentiator; the H1 in the
// hero keeps the plain product line. See docs: SEO brief, 2026-09-03.
const title = 'PCBJam — KiCad online, in your browser, with your team';
const description =
  "Run KiCad online: the full editor in your browser, with your team in the same project. KiCad's own file format, no install, no lock-in. Join the waitlist.";

const site = Astro.site ?? new URL('https://www.pcbjam.com');

const softwareLd = {
  '@type': 'SoftwareApplication',
  name: 'PCBJam',
  url: site.href,
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Web browser',
  description,
  screenshot: new URL('/landing/hero-poster.jpg', site).href,
  featureList: [
    'Schematic capture',
    'PCB layout',
    'DRC and ERC',
    '3D viewer',
    'Gerber and drill export',
    'Real-time collaboration',
    'KiCad file format import and export',
    'Team component libraries',
    'Public project publishing and invite links',
    'Viewer mode on Android phones and tablets',
  ],
  // Keep in sync with src/pages/pricing.astro.
  offers: [
    { '@type': 'Offer', name: 'Free', price: '0', priceCurrency: 'USD' },
    { '@type': 'Offer', name: 'Pro', price: '10', priceCurrency: 'USD' },
  ],
  creator: {
    '@type': 'Organization',
    name: 'Emergence Engineering',
    url: 'https://www.emergence-engineering.com',
  },
};

// The hero's YouTube demo. Dates/duration from the video's own metadata.
const videoLd = {
  '@type': 'VideoObject',
  name: 'PCBJam: KiCad on the web demo video',
  description:
    'A seven-minute walk through PCBJam: the KiCad schematic and PCB editors running in a browser, working on one project together, and exporting.',
  thumbnailUrl: ['https://i.ytimg.com/vi/6tXAyWIOZ_o/hqdefault.jpg'],
  uploadDate: '2026-09-03T06:05:17-07:00',
  duration: 'PT7M7S',
  embedUrl: 'https://www.youtube-nocookie.com/embed/6tXAyWIOZ_o',
  url: 'https://www.youtube.com/watch?v=6tXAyWIOZ_o',
};

const jsonLd = { '@context': 'https://schema.org', '@graph': [softwareLd, videoLd] };
---

<BaseLayout title={title} description={description} wide>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <Hero />
  <FullKicad />
  <OwnYourData />
  <SharePublish />
  <Pricing />
  <Roadmap />
  <Faq />
  <Contact />
</BaseLayout>
