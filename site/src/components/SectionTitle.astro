---
/**
 * SectionTitle — the landing page's README-style `## Heading`.
 * The `##` is decorative (hidden from assistive tech); the heading text is the slot.
 */
interface Props {
  id?: string;
}
const { id } = Astro.props;
---

<h2 class="section-title" id={id}><span class="hash" aria-hidden="true">##</span> <slot /></h2>

<style>
  .section-title {
    font-family: var(--font-mono);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
    color: var(--fg);
    scroll-margin-top: 4.5rem;
  }
  .hash {
    color: var(--red);
  }
</style>
