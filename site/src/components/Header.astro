---
// README-style header: jar mark + mono wordmark, four mono links. The primary
// call to action lives in the hero (#waitlist), not up here.
const links = [
  { href: 'https://demo.pcbjam.com', label: 'demo', external: true },
  { href: '/blog', label: 'blog' },
  { href: '/pricing', label: 'pricing' },
  { href: 'https://discord.gg/ybhqJxjR3E', label: 'discord', external: true },
];

const path = Astro.url.pathname;
const isActive = (href: string, external?: boolean) =>
  external ? false : href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header" transition:persist>
  <div class="container bar">
    <a class="brand" href="/">
      <img src="/favicon.svg" alt="" width="20" height="28" />
      <span class="brand-name">pcbjam</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle sr-only" />
    <label class="hamburger" for="nav-toggle" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="nav" aria-label="Primary">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={isActive(l.href, l.external) ? 'page' : undefined}
            rel={l.external ? 'noopener' : undefined}
            target={l.external ? '_blank' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.7rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--fg);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .brand:hover {
    text-decoration: none;
  }
  .brand img {
    height: 1.75rem;
    width: auto;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  .nav > a {
    color: var(--fg-muted);
    white-space: nowrap;
  }
  .nav > a:hover {
    color: var(--red);
    text-decoration: none;
  }
  .nav > a[aria-current='page'] {
    color: var(--fg);
  }

  /* Mobile menu (CSS-only via checkbox toggle). */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: 0.4rem;
    cursor: pointer;
  }
  .hamburger span {
    width: 22px;
    height: 2px;
    background: var(--fg);
    border-radius: 2px;
  }
  @media (max-width: 560px) {
    .hamburger {
      display: flex;
    }
    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      padding: 0.25rem 1.25rem 0.75rem;
      display: none;
    }
    .nav-toggle:checked ~ .nav {
      display: flex;
    }
    .nav > a {
      padding-block: 0.7rem;
      border-bottom: 1px solid var(--border);
    }
    .nav > a:last-child {
      border-bottom: 0;
    }
  }
</style>

<script>
  // ClientRouter persists the header (transition:persist). Reset the mobile
  // menu after every navigation, and close it when any nav link is tapped
  // (same-page anchors scroll without firing astro:page-load).
  function initMobileNav() {
    const toggle = document.getElementById('nav-toggle') as HTMLInputElement | null;
    if (!toggle) return;
    toggle.checked = false;

    const nav = document.querySelector<HTMLElement>('.nav');
    if (!nav || nav.dataset.bound === '1') return; // header persists — bind once
    nav.dataset.bound = '1';
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) toggle.checked = false;
    });
  }
  document.addEventListener('astro:page-load', initMobileNav);
</script>
