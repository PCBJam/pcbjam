---
// The call to action lives in the hero, not up here — and so does the demo link.
import SiteHeader, { type HeaderLink } from '../brand/SiteHeader.astro';
import { APP_URL } from '../lib/app-url';

const links: HeaderLink[] = [
  { href: APP_URL, label: 'app', primary: true }, // same tab + same red as the hero's "Go to app"
  { href: '/blog', label: 'blog' },
  { href: '/pricing', label: 'pricing' },
  { href: 'https://discord.gg/ybhqJxjR3E', label: 'discord', external: true },
];
---

<SiteHeader links={links} path={Astro.url.pathname} />
