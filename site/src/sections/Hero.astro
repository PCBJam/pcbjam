---
import WaitlistForm from '../components/WaitlistForm.astro';

const DISCORD_URL = 'https://discord.gg/ybhqJxjR3E';
const DEMO_URL = 'https://demo.pcbjam.com';
---

<section class="readme hero">
  <h1>Collaborative KiCad in the browser.</h1>
  <p class="lead">
    Run KiCad online: schematic capture, PCB layout, DRC, 3D and Gerber export, in a tab.
    Work on the same project with your team at the same time. Your files stay in KiCad's own
    format.
  </p>

  <WaitlistForm source="hero" id="waitlist" class="hero-form">
    <Fragment slot="micro">
      or <a href={DISCORD_URL} rel="noopener" target="_blank">join the Discord</a> ·
      <a href={DEMO_URL} rel="noopener" target="_blank">open the demo</a> (no account) ·
      <a href="/privacy">privacy</a>
    </Fragment>
  </WaitlistForm>

  {/* Demo video (YouTube, privacy-enhanced host: no cookies until play). The
      landing page is deliberately NOT cross-origin isolated (see public/_headers)
      so this iframe can load. */}
  <figure class="loop">
    <div class="frame video">
      <iframe
        src="https://www.youtube-nocookie.com/embed/6tXAyWIOZ_o?rel=0"
        title="PCBJam: KiCad on the web, demo video"
        loading="lazy"
        allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>
    <figcaption class="mono small muted">
      7 minute demo · <a href="https://www.youtube.com/watch?v=6tXAyWIOZ_o" rel="noopener" target="_blank">watch on YouTube</a>
    </figcaption>
  </figure>
</section>

<style>
  .hero {
    padding-block: 2.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  h1 {
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.12;
    margin: 0;
    text-wrap: balance;
  }
  .lead {
    margin: 0;
    font-size: 1.1rem;
    color: var(--fg-muted);
    max-width: 40rem;
    text-wrap: pretty;
  }
  .hero-form {
    max-width: 32rem;
  }
  .loop {
    margin: 0.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .video {
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .video iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
