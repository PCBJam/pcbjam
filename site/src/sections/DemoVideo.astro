---
import SectionTitle from '../components/SectionTitle.astro';
---

{/* The long-form demo (YouTube, privacy-enhanced host: no cookies until play).
    Moved out of the hero, which now carries the short loop. Its VideoObject
    JSON-LD stays in pages/index.astro. The landing page is deliberately NOT
    cross-origin isolated (see public/_headers) so this iframe can load. */}
<section class="readme readme-section" id="demo">
  <SectionTitle>See it end to end</SectionTitle>
  <p>
    Seven minutes in the editor: the schematic and PCB editors in a browser tab, a team working
    on one project together, and the export at the end.
  </p>
  <figure class="loop">
    <div class="frame video">
      <iframe
        src="https://www.youtube-nocookie.com/embed/6tXAyWIOZ_o?rel=0"
        title="PCBJam: KiCad on the web, demo video"
        loading="lazy"
        allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>
    <figcaption class="mono small muted">
      7 minute demo · <a href="https://www.youtube.com/watch?v=6tXAyWIOZ_o" rel="noopener" target="_blank">watch on YouTube</a>
    </figcaption>
  </figure>
</section>

<style>
  .loop {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: var(--measure);
  }
  .video {
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .video iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
